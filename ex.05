let num1 = Number(prompt("digite um numero"));
if(num1 % 3 == 0 && num1 %  5==0){
    alert("o numero e divisivel por 3 e por 5");
}
else if(num1 % 3 == 0){
    alert("o numero e divisel por 3");
}
else if(num1 % 5 == 0){
    alert("o numero e divisel por 5");
}
else{
    alert("o numero nao e divisel por 5 e nem  por 3");
}
